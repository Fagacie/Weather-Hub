# Copy to .env.local to override defaults (optional)
VITE_WEATHER_API_BASE_URL=/api

# Firebase — defaults are in src/js/firebase-config.js (weather-hub-5ccbb)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional local Maps fallback. In production the browser key is served by
# GET /api/config/public so it is never baked into the bundle.
VITE_GOOGLE_MAPS_API_KEY=

# Server-side keys are NEVER set here. They are Firebase Functions secrets:
#   firebase functions:secrets:set OPENWEATHER_API_KEY
#   firebase functions:secrets:set GOOGLE_TRANSLATE_API_KEY
#   firebase functions:secrets:set GOOGLE_MAPS_API_KEY        (browser key, referrer-restricted)
#   firebase functions:secrets:set GOOGLE_MAPS_SERVER_KEY     (geocoding key, API-restricted)
