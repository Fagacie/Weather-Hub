# Copy to .env.local to override defaults (optional)
VITE_WEATHER_API_BASE_URL=/api

# Firebase — defaults are in src/js/firebase-config.js (weather-hub-5ccbb)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional local Maps fallback — production uses /api/config/public
VITE_GOOGLE_MAPS_API_KEY=
